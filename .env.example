# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase service-role key (Project Settings > API). Bypasses
# Row Level Security entirely — used ONLY by lib/supabase/admin.ts, for
# narrowly-scoped trusted server flows that have no user session (the
# Shopify OAuth callback, the Shopify app/uninstalled webhook) or that need
# to reach a table with no anon/authenticated grants after the caller has
# already independently verified ownership in application code. NEVER
# expose this as a NEXT_PUBLIC_* variable, return it from any action, log
# it, or include it in any AI prompt or preview token. Never commit the
# real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only 64-character hex key (32 bytes) used to encrypt stored WordPress
# Application Passwords with AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value.
WORDPRESS_CREDENTIAL_ENCRYPTION_KEY=

# Server-only 64-character hex key (32 bytes) used to HMAC-sign fix-preview
# tokens (lib/fixes/preview-token.ts) — proves at Apply Fix time that the
# exact title being written is the one the user actually approved. Must be
# DIFFERENT from WORDPRESS_CREDENTIAL_ENCRYPTION_KEY. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for Apply Fix to function at all. Never commit the real value.
FIX_PREVIEW_SIGNING_KEY=

# Optional. Anthropic API key used only for AI-assisted title
# recommendations (lib/ai/client.ts). If omitted, Website Care falls back to
# its deterministic title proposals — nothing else is affected.
# Never expose this as a NEXT_PUBLIC_* variable.
ANTHROPIC_API_KEY=

# Shopify app credentials (Partner Dashboard > App setup). Required for the
# Shopify OAuth connection flow (lib/integrations/shopify/). Never expose
# these as NEXT_PUBLIC_* variables — the client secret in particular must
# never reach the browser.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Pinned Shopify Admin API version, e.g. "2026-07" — never "latest" or
# "unstable". See lib/integrations/shopify/config.ts.
SHOPIFY_API_VERSION=

# The canonical, server-controlled base URL webioom is deployed at, used to
# build the OAuth redirect_uri sent to Shopify. Must exactly match the
# redirect URL registered for this app in the Shopify Partner Dashboard.
# Must be an https:// URL. Deliberately NOT derived from an incoming
# request's Host header (attacker-influenceable) — see
# lib/integrations/shopify/config.ts.
SHOPIFY_APP_URL=

# Wix app credentials (dev.wix.com app dashboard > OAuth page). Required
# for the Wix connection flow (lib/integrations/wix/). Never expose these
# as NEXT_PUBLIC_* variables — the client secret in particular must never
# reach the browser. Unlike Shopify, there is no separate API-version
# variable — Wix's REST endpoints are individually versioned by path, not
# by a single app-wide parameter. See lib/integrations/wix/config.ts.
WIX_APP_ID=
WIX_APP_SECRET=

# The canonical, server-controlled base URL webioom is deployed at, used to
# build the External Install Flow's postInstallationUrl callback sent to
# Wix. Must be an https:// URL. Deliberately NOT derived from an incoming
# request's Host header — see lib/integrations/wix/config.ts.
WIX_APP_URL=

# Paddle server-side API key (Paddle dashboard > Developer tools >
# Authentication). A sandbox key only works against
# PADDLE_ENVIRONMENT=sandbox; a live key only works against
# PADDLE_ENVIRONMENT=production — the two are never interchangeable. Never
# expose this as a NEXT_PUBLIC_* variable. See lib/paddle/config.ts.
PADDLE_API_KEY=

# "sandbox" or "production" — selects both the API base URL
# (sandbox-api.paddle.com vs api.paddle.com) and which set of credentials
# is valid. Sandbox and live are completely separate Paddle accounts with
# separate products/prices/customers — nothing is shared between them.
PADDLE_ENVIRONMENT=sandbox

# The secret key for the Paddle notification destination (webhook) you
# configure manually in the Paddle dashboard after deployment — NOT the
# same value as PADDLE_API_KEY. Used only to verify the Paddle-Signature
# header on incoming webhooks (lib/paddle/webhook-signature.ts). Never
# expose this as a NEXT_PUBLIC_* variable. Never commit the real value.
PADDLE_WEBHOOK_SECRET=

# Public Paddle client-side token (Paddle dashboard > Developer tools >
# Authentication > client-side tokens), used by Paddle.js in the browser to
# open the checkout overlay. This one IS meant to be public — it is
# deliberately NEXT_PUBLIC_* and carries no write access on its own.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Paddle price IDs (pri_...) for webioom's two paid plans, created in the
# Paddle dashboard (Catalog > Products & prices) for the environment named
# above. `free` intentionally has no price ID — there is nothing to check
# out for the free plan. Never hardcode a price ID in source; only
# lib/paddle/config.ts's getPaddlePriceMapping reads these, and
# lib/paddle/plan-mapping.ts is the only place they are ever compared
# against a webhook's subscribed price.
PADDLE_BLOOM_PRICE_ID=
PADDLE_BLOOM_PRO_PRICE_ID=
