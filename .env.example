# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only 64-character hex key (32 bytes) used to encrypt stored WordPress
# Application Passwords with AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value.
WORDPRESS_CREDENTIAL_ENCRYPTION_KEY=

# Server-only 64-character hex key (32 bytes) used to HMAC-sign fix-preview
# tokens (lib/fixes/preview-token.ts) — proves at Apply Fix time that the
# exact title being written is the one the user actually approved. Must be
# DIFFERENT from WORDPRESS_CREDENTIAL_ENCRYPTION_KEY. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for Apply Fix to function at all. Never commit the real value.
FIX_PREVIEW_SIGNING_KEY=

# Optional. Anthropic API key used only for AI-assisted title
# recommendations (lib/ai/client.ts). If omitted, Website Care falls back to
# its deterministic title proposals — nothing else is affected.
# Never expose this as a NEXT_PUBLIC_* variable.
ANTHROPIC_API_KEY=
